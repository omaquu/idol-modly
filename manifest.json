{
  "id": "idol",
  "name": "IDOL",
  "type": "model",
  "source": "https://github.com/omaquu/idol-modly",
  "description": "Single-image to 3D Gaussian Splatting powered by Speridlabs IDOL. Generates high-density 3D Gaussians and watertight meshes locally on your GPU.",
  "version": "1.0.0",
  "author": "omaquu",
  "generator_class": "IdolGenerator",
  "vram_gb": 8,
  "tags": ["image-to-3d", "gaussian-splatting", "mesh", "fast", "projection"],
  "nodes": [
    {
      "id": "generate",
      "name": "IDOL (Mesh)",
      "input": "image",
      "output": "mesh",
      "hf_repo": "speridlabs/idol",
      "download_check": "denoiser.safetensors",
      "hf_skip_prefixes": [],
      "params_schema": [
        {
          "id": "mode",
          "label": "Input Mode",
          "type": "select",
          "default": "synthetic",
          "options": [
            {"value": "synthetic", "label": "Synthetic / Render / AI (Crop 1.2)"},
            {"value": "real", "label": "Real Photograph (Crop 1.7)"}
          ],
          "tooltip": "Use 'synthetic' for AI-generated images or digital renders, 'real' for real-world photos."
        },
        {
          "id": "steps",
          "label": "Sampling Steps",
          "type": "int",
          "default": 30,
          "min": 10,
          "max": 60,
          "tooltip": "Number of flow-matching sampling steps. Higher values improve quality but take longer."
        },
        {
          "id": "num_gaussians",
          "label": "Gaussians",
          "type": "select",
          "default": 131072,
          "options": [
            {"value": 32768, "label": "32k (Fast / Low VRAM)"},
            {"value": 65536, "label": "65k"},
            {"value": 131072, "label": "131k (Balanced)"},
            {"value": 262144, "label": "262k (High Detail)"},
            {"value": 524288, "label": "524k (Ultra)"}
          ],
          "tooltip": "Number of 3D Gaussians to generate."
        },
        {
          "id": "grid_resolution",
          "label": "Mesh Detail",
          "type": "select",
          "default": 224,
          "options": [
            {"value": 160, "label": "Medium (160 - fast)"},
            {"value": 224, "label": "High (224 - recommended)"},
            {"value": 288, "label": "Ultra (288 - finest armor detail)"}
          ],
          "tooltip": "Surface Nets / TSDF grid resolution. Higher = finer surface detail and crisper edges."
        },
        {
          "id": "mesh_smoothing",
          "label": "Mesh Smoothing",
          "type": "select",
          "default": "Medium",
          "options": [
            {"value": "None", "label": "None (crispest)"},
            {"value": "Light", "label": "Light"},
            {"value": "Medium", "label": "Medium"},
            {"value": "Strong", "label": "Strong (softest)"}
          ],
          "tooltip": "Taubin volume-preserving smoothing iterations."
        },
        {
          "id": "color_mode",
          "label": "Color Mode",
          "type": "select",
          "default": "Refined",
          "options": [
            {"value": "Natural", "label": "Natural"},
            {"value": "Vivid", "label": "Vivid (more saturated)"},
            {"value": "Refined", "label": "Refined (+30-60s)"}
          ],
          "tooltip": "Refined fits the colors to multi-view renders of the Gaussian splat."
        },
        {
          "id": "texture",
          "label": "Texture",
          "type": "select",
          "default": "Auto",
          "options": [
            {"value": "Auto", "label": "Auto (best, +2min)"},
            {"value": "Vertex colors", "label": "Vertex colors (fast)"},
            {"value": "Baked 1K", "label": "Baked 1K"},
            {"value": "Baked 2K", "label": "Baked 2K"},
            {"value": "Baked 4K", "label": "Baked 4K (Ultra)"}
          ],
          "tooltip": "Auto: bakes refined 2K UV texture directly from Gaussians with xatlas unwrapping (or choose Baked 4K for maximum crispness)."
        },
        {
          "id": "cfg_strength",
          "label": "CFG Strength",
          "type": "int",
          "default": 3,
          "min": 1,
          "max": 7,
          "tooltip": "Classifier-free guidance strength."
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": 42,
          "min": -1,
          "max": 2147483647,
          "tooltip": "Random seed (-1 for random)."
        }
      ]
    },
